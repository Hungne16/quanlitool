rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kiểm tra xem người dùng hiện tại có phải là admin không
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Công cụ (tools)
    match /tools/{toolId} {
      // Bất kỳ ai cũng có thể xem công cụ
      allow read: if true;
      // Người dùng đã đăng nhập có thể thêm công cụ (sẽ cần admin duyệt)
      allow create: if request.auth != null;
      // Chỉ admin mới có quyền sửa hoặc xóa công cụ
      allow update, delete: if isAdmin();
    }
    
    // Cài đặt danh mục (settings)
    match /settings/{docId} {
      // Bất kỳ ai cũng có thể xem danh mục
      allow read: if true;
      // Chỉ admin mới được sửa danh mục
      allow write: if isAdmin();
    }
    
    // Quản lý người dùng (users)
    match /users/{userId} {
      // Cho phép người dùng đã đăng nhập đọc danh sách users để ứng dụng có thể kiểm tra FirstUser
      allow read: if request.auth != null;
      // Cho phép người dùng tự cập nhật/tạo profile của chính họ, hoặc admin
      allow create, update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
