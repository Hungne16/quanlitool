rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to get the user's role from the users collection (defaults to member)
    function getUserRole() {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      let userDoc = exists(userRef) ? get(userRef) : null;
      return userDoc == null || !('role' in userDoc.data) ? 'member' : userDoc.data.role;
    }
    
    // Function to check if user is active (defaults to active if missing)
    function isActive() {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      let userDoc = exists(userRef) ? get(userRef) : null;
      return userDoc == null || !('status' in userDoc.data) || userDoc.data.status == 'active';
    }

    // Function to check admin privileges
    function isAdmin() {
      return isAuthenticated() && isActive() && (getUserRole() == 'admin' || getUserRole() == 'super_admin');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Any authenticated user can read any profile (for leaderboard)
      allow read: if isAuthenticated();
      // Admins can also read all profiles
      allow read: if isAdmin();
      
      // Users can create their own profile upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own favorites and points
      allow update: if isAuthenticated() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasAny(['favorites', 'points', 'nickname']);
      
      // Admins can update/delete any user profile
      allow update, delete: if isAdmin();
    }

    // --- TOOLS COLLECTION ---
    match /tools/{toolId} {
      // Anyone can read approved tools
      allow read: if resource.data.status == 'approved';
      
      // Legacy tools (without status field) can be read by anyone
      allow read: if !('status' in resource.data);
      
      // Users can read tools they submitted (even if pending)
      allow read: if isAuthenticated() && resource.data.submittedBy == request.auth.uid;
      
      // Admins can read all tools
      allow read: if isAdmin();
      
      // Authenticated active users can create new tools (must be pending if not admin)
      allow create: if isAuthenticated() && isActive() && 
        (isAdmin() || request.resource.data.status == 'pending');
      
      // Only admins can update or delete tools completely
      // Regular users can ONLY update the ratings and comments field
      // ANYONE (even guests) can update the clicks field
      allow update: if isAdmin() 
        || (isAuthenticated() && isActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings', 'comments', 'clicks']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']));
      
      allow delete: if isAdmin();
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isAuthenticated() && isActive();
    }

    // --- AI CHAT LOGS COLLECTION ---
    match /ai_chat_logs/{logId} {
      allow create: if true; // anyone can chat
      allow read, update, delete: if isAdmin();
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{docId} {
      // Anyone can read settings/categories
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }
  }
}
